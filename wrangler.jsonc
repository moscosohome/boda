{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boda",
  "compatibility_date": "2026-11-11",
  "pages_build_output_dir": "dist/boda-cristina-antonio/browser",
  "d1_databases": [
    {
      "binding": "WEDDING_DB",
      "database_name": "boda-fotos",
      "database_id": "e3f5119d-084d-4d1b-b3df-227c02fc2428",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "WEDDING_PHOTOS",
      "bucket_name": "boda-fotos-private",
      "preview_bucket_name": "boda-fotos-private-preview"
    }
  ],
  "vars": {
    "MAX_STORAGE_BYTES": "8000000000",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF8vUp8_txIieGwa",
    "TURNSTILE_EXPECTED_HOSTNAME": "cristinayantonio.com.es",
    "CF_ACCESS_TEAM_DOMAIN": "https://amfhomeassistant.cloudflareaccess.com",
    "CF_ACCESS_AUD": "adf813f68ea4e746df66d1b0920427db56dd6740b5b3a2d439e7d757cd68ee5c"
  }
}
